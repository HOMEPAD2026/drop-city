{
  "functions": {
    "api/pad.mjs": {
      "maxDuration": 60,
      "includeFiles": "{index.html,images/agent/**}"
    },
    "api/tg.mjs": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/coin/:mint",
      "destination": "/api/pad?page=:mint"
    },
    {
      "source": "/nft",
      "destination": "/api/pad?page=nft"
    },
    {
      "source": "/lp",
      "destination": "/api/pad?page=lp"
    },
    {
      "source": "/w/:wallet",
      "destination": "/api/pad?page=w&w=:wallet"
    }
  ]
}
